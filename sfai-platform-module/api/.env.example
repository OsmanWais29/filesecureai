# Local development. On AWS these are set by the CDK construct (infra/lib/sfai-module.ts).

# Database: leave unset to use the built-in PGlite database in ./.data
# DATABASE_URL=postgres://user:pass@localhost:5432/sfai

# Front end + this API's public URL (OAuth redirects, website embed)
APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000

# Login (shared Cognito user pool). The dev server uses fake headers instead.
# COGNITO_USER_POOL_ID=ca-central-1_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Set to true to send real email/SMS/S3 from the dev server (needs AWS credentials)
DEV_LIVE_AWS=false
AWS_REGION=ca-central-1
EMAIL_FROM=crm@example.com
# DOCS_BUCKET=my-dev-bucket

# Integrations (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT=common
OAUTH_STATE_SECRET=change-me-locally

# Ask your CRM (Amazon Bedrock)
# BEDROCK_REGION=ca-central-1
# BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
# BEDROCK_FALLBACK_MODEL_ID=anthropic.claude-opus-4-8
# Document analysis model (defaults to BEDROCK_MODEL_ID). A cheaper model works too.
# ANALYSIS_MODEL_ID=anthropic.claude-opus-5-5

# Background jobs: unset locally (jobs run inline). On AWS the CDK sets the SQS URL.
# JOBS_QUEUE_URL=
